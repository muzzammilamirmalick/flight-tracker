# Example settings for the Pi. Copy to /etc/flighttracker/flighttracker.env and fill in the password.
# Never commit the real file. Nested settings use a double underscore: Readsb:Url becomes Readsb__Url.

# Listen on port 5000 on every network address, so other devices at home can open the map.
ASPNETCORE_URLS=http://0.0.0.0:5000

# The database on the Pi itself.
ConnectionStrings__FlightTracker=Host=localhost;Port=5432;Database=flighttracker;Username=flighttracker_app;Password=CHANGE_ME

# Read planes from the receiver running on the same Pi.
AircraftSource=Readsb
Readsb__Url=http://localhost/tar1090/data/aircraft.json

# Only needed if AircraftSource=OpenSky.
# OpenSky__ClientId=
# OpenSky__ClientSecret=
